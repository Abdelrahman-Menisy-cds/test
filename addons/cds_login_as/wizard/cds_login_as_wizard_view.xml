<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="cds_login_as_wizard_view_form" model="ir.ui.view">
            <field name="name">cds.login.as.wizard.view.form</field>
            <field name="model">cds.login.as.wizard</field>
            <field name="arch" type="xml">
                <form string="Login As">
                    <sheet>
                        <group>
                            <field name="user_id"
                                   options="{'no_open': True, 'no_create': True}"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_login_as" string="Login"
                                type="object" class="oe_highlight"/>
                        or
                        <button special="cancel" string="Cancel"/>
                    </footer>
                </form>
            </field>
        </record>
