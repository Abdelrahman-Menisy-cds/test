<odoo>
    <data>
        <!-- Sale Order Form View -->
        <record id="view_order_form_inherit_sale_internal_transfer" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.sale.internal.transfer</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='date_order']" position="after">
                    <field name="internal_transfer_id" 
                           readonly="[('state', 'not in', ['draft', 'sent'])]"
                           options="{'no_create': True, 'no_create_edit': True}"/>
                </xpath>
            </field>
        </record>

        <!-- Sale Order Tree View -->
        <record id="view_order_tree_inherit_sale_internal_transfer" model="ir.ui.view">
            <field name="name">sale.order.tree.inherit.sale.internal.transfer</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='state']" position="before">
                    <field name="internal_transfer_id" optional="show"/>
                </xpath>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_sales_order_filter_inherit_sale_internal_transfer" model="ir.ui.view">
            <field name="name">sale.order.filter.inherit.sale.internal.transfer</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_sales_order_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='my_sale_orders']" position="after">
                    <separator/>
                    <filter string="With Internal Transfer" name="with_internal_transfer" domain="[('internal_transfer_id', '!=', False)]"/>
                    <filter string="Without Internal Transfer" name="without_internal_transfer" domain="[('internal_transfer_id', '=', False)]"/>
                </xpath>
                <xpath expr="//group" position="inside">
                    <filter string="Internal Transfer" name="internal_transfer" domain="[]" context="{'group_by': 'internal_transfer_id'}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
