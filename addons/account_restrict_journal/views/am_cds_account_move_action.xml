<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Override Journal Entries action to filter by allowed journals -->
    <record id="am_cds_action_move_journal_line" model="ir.actions.server">
        <field name="name">Journal Entries</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="state">code</field>
        <field name="code">action = model.am_cds_action_move_journal_line()</field>
    </record>

    <!-- Override the menu to use our filtered action -->
    <record id="account.menu_action_move_journal_line_form" model="ir.ui.menu">
        <field name="action" ref="am_cds_action_move_journal_line"/>
    </record>
</odoo>
