<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
     <record id="view_order_form_inherit_sale" model="ir.ui.view">
            <field name="name">sale.order.form.sale.inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                 <xpath expr="//field[@name='partner_id']" position="before">
                      <field name="is_take_group" invisible="1"/>
                </xpath>
                <xpath expr="//button[@id='create_invoice']"  position="attributes">
                      <attribute name="invisible">is_take_group == False or invoice_status != 'to invoice' </attribute>
                </xpath>
                <xpath expr="//button[@name='action_view_invoice']" position="attributes">
                      <attribute name="invisible">is_take_group == False or invoice_count == 0 </attribute>
                </xpath>
            </field>
        </record>    
    </data>
</odoo>    