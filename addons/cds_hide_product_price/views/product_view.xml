<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="product_template_form_view_hide_price"
                model="ir.ui.view">
            <field name="name">product.template.form</field>
            <field name="model">product.template</field>
            <field name="inherit_id"
                   ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook//page[1]//group[1]//group[2]//div[@name='list_price_uom']"
                       position="attributes">
                    <attribute name="groups">cds_hide_product_price.group_show_product_product_price</attribute>
                </xpath>
                <xpath expr="//notebook//page[1]//group[1]//group[2]//label[@for='list_price']"
                       position="attributes">
                    <attribute name="groups">cds_hide_product_price.group_show_product_product_price</attribute>
                </xpath>
                <!--                 <xpath expr="//button[@name='open_pricelist_rules']"-->
                <!--                       position="attributes">-->
                <!--                    <attribute name="groups">cds_hide_product_price.group_show_product_product_price</attribute>-->
                <!--                </xpath>-->


            </field>
        </record>
        <record id="product_template_tree_view_hide_price" model="ir.ui.view">
            <field name="name">product.template.list</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_tree_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='list_price']"
                       position="attributes">
                    <attribute name="groups">cds_hide_product_price.group_show_product_product_price</attribute>
                </xpath>

            </field>
        </record>

        <record id="product_product_tree_view_hide_price" model="ir.ui.view">
            <field name="name">product.product.list</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_product_tree_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='lst_price']" position="attributes">
                    <attribute name="groups">cds_hide_product_price.group_show_product_product_price</attribute>
                </xpath>

            </field>
        </record>

        <record id="product_template_kanban_view_price" model="ir.ui.view">
            <field name="name">product.form</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_kanban_view"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='list_price']" position="attributes">
                    <attribute name="groups">cds_hide_product_price.group_show_product_product_price</attribute>
                </xpath>


            </field>
        </record>


        <record id="product_kanban_view_price" model="ir.ui.view">
            <field name="name">product.form</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_kanban_view"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='lst_price']" position="attributes">
                    <attribute name="groups">cds_hide_product_price.group_show_product_product_price</attribute>
                </xpath>


            </field>
        </record>

        <!-- Hide price in product.product (variant) form view -->
        <record id="product_normal_form_view_hide_price" model="ir.ui.view">
            <field name="name">product.product.form.hide.price</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_normal_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='lst_price']" position="attributes">
                    <attribute name="groups">cds_hide_product_price.group_show_product_product_price</attribute>
                </xpath>
                <xpath expr="//label[@for='lst_price']" position="attributes">
                    <attribute name="groups">cds_hide_product_price.group_show_product_product_price</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>