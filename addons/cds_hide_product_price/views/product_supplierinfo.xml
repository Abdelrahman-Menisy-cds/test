<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_supplierinfo_tree_view_group" model="ir.ui.view">
        <field name="name">product.supplierinfo.list.view</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="product.product_supplierinfo_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='price']"  position="attributes">
                          <attribute name="invisible">is_take_group == False </attribute>
            </xpath>
            <xpath expr="//field[@name='price']" position="before">
              <field name="is_take_group" invisible="1" />
            </xpath>
        </field>    
    </record> 

     <record id="product_supplierinfo_form_view_group" model="ir.ui.view">
        <field name="name">product.supplierinfo.form.view</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="product.product_supplierinfo_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='price']" position="before">
              <field name="is_take_group" invisible="1" />
            </xpath>
             <xpath expr="//field[@name='price']"  position="attributes">
                      <attribute name="invisible">is_take_group == False </attribute>
             </xpath>
              <xpath expr="//label[@for='price']"  position="attributes">
                      <attribute name="invisible">is_take_group == False </attribute>
             </xpath>
             

        </field>
    </record>
   


</odoo>