    </record>

    <record id="am_cds_group_pos_hide_action_menu" model="res.groups">
        <field name="name">POS show Hide Top Action Menu</field>
        <field name="comment">Used to hide the View/Reporting action dropdown in POS configs.</field>
    </record>
</odoo>
