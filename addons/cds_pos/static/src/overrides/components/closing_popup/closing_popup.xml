        <!-- Hide Difference field -->
        <xpath expr="//div[hasclass('text-muted')][hasclass('border-start')][span[text()='Difference']]" position="attributes">
            <attribute name="t-if">false</attribute>
        </xpath>
    </t>

</templates>
