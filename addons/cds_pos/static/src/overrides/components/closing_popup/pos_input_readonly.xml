<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="cds_pos.PosInputReadonly" t-inherit="point_of_sale.input" t-inherit-mode="extension">
        <xpath expr="//input[hasclass('o_input')][hasclass('border-0')][hasclass('mx-2')][hasclass('text-body')]" position="attributes">
            <attribute name="t-att-readonly">props.readonly || (props.class &amp;&amp; props.class.includes('cds_close_readonly'))</attribute>
        </xpath>
    </t>

</templates>
