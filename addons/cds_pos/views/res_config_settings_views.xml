<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cds_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">cds.res.config.settings.view.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']/setting[@id='multiple_employee_session']" position="after">
                <setting id="pos_show_invoice_button_setting" string="Show/Hide Invoice Button" help="Control the visibility of the Invoice button on the payment screen">
                    <field name="pos_show_invoice_button"/>
                </setting>
                <setting id="pos_refund_period_setting" title="Set " string="POS Refund Period" help="Allow to Set The period for pos refund">
                    <field name="pos_refund_period"/>
                </setting>
                <setting id="load_pos_order_days_setting" title="Set " string="POS Load Order Days" help="Allow to Set Load Pos Order Days">
                    <field name="enable_load_pos_orders_days"/>
                    <field name="load_pos_orders_days" invisible="not enable_load_pos_orders_days"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>