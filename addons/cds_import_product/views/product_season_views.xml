<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_season_form" model="ir.ui.view">
        <field name="name">product.season.form</field>
        <field name="model">product.season</field>
        <field name="arch" type="xml">
            <form string="MODEL" create="true" duplicate="true" edit="true" delete="true">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_product_season_list" model="ir.ui.view">
        <field name="name">product.season.list</field>
        <field name="model">product.season</field>
        <field name="arch" type="xml">
            <list create="true" duplicate="true" edit="true" delete="true">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_product_season_action" model="ir.actions.act_window">
        <field name="name">Product season</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.season</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menuitem_product_season" name="Product Season" parent="stock.menu_stock_inventory_control" action="view_product_season_action" sequence="99"/>

</odoo>
