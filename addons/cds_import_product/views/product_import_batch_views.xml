<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree view for import batches -->
    <record id="view_product_import_batch_tree" model="ir.ui.view">
        <field name="name">product.import.batch.tree</field>
        <field name="model">product.import.batch</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'done'" 
                  decoration-danger="state == 'failed'" 
                  decoration-info="state == 'draft'">
                <field name="create_date"/>
                <field name="name"/>
                <field name="product_count"/>
                <field name="state"/>
                <field name="create_uid"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <button name="action_import_batch" 
                        string="Import" 
                        type="object"
                        invisible="state != 'draft'"
                        class="btn-primary"/>
                <field name="error_message" 
                       invisible="state != 'failed'"/>
            </tree>
        </field>
    </record>

    <!-- Form view for import batches -->
    <record id="view_product_import_batch_form" model="ir.ui.view">
        <field name="name">product.import.batch.form</field>
        <field name="model">product.import.batch</field>
        <field name="arch" type="xml">
            <form string="Import Batch">
                <header>
                    <button name="action_import_batch" 
                            string="Import" 
                            type="object"
                            invisible="state != 'draft'"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Batch Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_count"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="create_date"/>
                            <field name="create_uid"/>
                        </group>
                    </group>
                    <group invisible="state != 'failed'">
                        <field name="error_message" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search view for import batches -->
    <record id="view_product_import_batch_search" model="ir.ui.view">
        <field name="name">product.import.batch.search</field>
        <field name="model">product.import.batch</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="create_uid"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Failed" name="failed" domain="[('state', '=', 'failed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Created By" name="group_by_user" context="{'group_by': 'create_uid'}"/>
                    <filter string="Date" name="group_by_date" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action for import batches -->
    <record id="action_product_import_batch" model="ir.actions.act_window">
        <field name="name">Import Batches</field>
        <field name="res_model">product.import.batch</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_product_import_batch_search"/>
        <field name="context">{'search_default_draft': 1}</field>
    </record>

    <!-- Menu item -->
    <menuitem id="menu_import_batches"
              name="Import Batches"
              parent="stock.menu_stock_inventory_control"
              action="action_product_import_batch"
              sequence="100"/>
</odoo>
