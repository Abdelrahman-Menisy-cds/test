<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_pos_config" model="ir.ui.view">
        <field name="name">res.config.settings.pos.config</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
           <xpath expr="//block[@id='pos_accounting_section']" position="after">
               <block title="CDS Import sale" id="pos_cds_import_section">
                   <setting id="pos_sale_domain" title="Domain">
                       <field name="pos_sale_domain" widget="domain" options="{'model': 'sale.order'}" force_save="1"/>
                   </setting>
               </block>
           </xpath>
        </field>
    </record>
</odoo>
