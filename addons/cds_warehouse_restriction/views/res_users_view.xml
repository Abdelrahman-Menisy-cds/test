<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_users_view_form" model="ir.ui.view">
            <field name="name">res.users.form</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">

                <xpath expr="//notebook" position="inside">
                    <page name="stock_operations" string="Inventory">
                        <group>
                            <field name="allow_picking_type_ids"
                                   widget="many2many_tags"/>
                            <field name="view_picking_type_ids"
                                   widget="many2many_tags" invisible="1"/>
                            <field name="allowed_warehouse_ids"
                                   widget="many2many_tags"/>
                            <field name="allowed_location_ids"
                                   widget="many2many_tags"/>
                             <field name="allowed_route_ids"
                                   widget="many2many_tags"/>
                        </group>

                    </page>
                </xpath>


            </field>
        </record>


    </data>
</odoo>