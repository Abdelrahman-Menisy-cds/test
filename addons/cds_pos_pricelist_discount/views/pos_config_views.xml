<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- View pos.config form -->
    <record id="view_pos_config_form" model="ir.ui.view">
        <field name="name">view.res.config.config.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
 
            <xpath expr="//setting[@id='price_control']" position="inside">
                <!-- <setting  id="discount_pricelist_setting" groups="base.group_multi_currency,product.group_product_pricelist"> -->
                    <span class="o_form_label">Discount Pricelist</span>
                    <div class="content-group" groups="base.group_multi_currency,product.group_product_pricelist" >
                      <field name="pos_discount_pricelist_id" domain="[('id', 'in', pos_allowed_pricelist_ids)]" options="{'no_create': True}"/>
                    </div>

            </xpath>
            
        </field>
    </record>

</odoo>