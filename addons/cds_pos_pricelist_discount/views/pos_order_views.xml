<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- View pos.order.line form -->
    <record id="view_pos_order_line_form" model="ir.ui.view">
        <field name="name">view.pos.order.form</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lines']/list/field[@name='discount']" position="after">
                <field name="discount_amount" />
            </xpath>

            <xpath expr="//field[@name='amount_tax']" position="after">
                <field name="total_without_discount"
                                   widget="monetary"/>
                <field name="total_discount_amount" widget="monetary"/>
            </xpath>
        </field>
    </record>

</odoo>